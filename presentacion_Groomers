<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yofren Master Pet Grooming — Una Nueva Era</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --gold:#C9A84C;
  --gold2:#E8C87A;
  --green:#6ABF1E;
  --green-dark:#1E3D25;
  --bg:#0A0F0D;
  --bg2:#0F1A14;
  --bg3:#142018;
  --border:rgba(201,168,76,0.15);
  --ink:rgba(255,255,255,0.92);
  --ink2:rgba(255,255,255,0.55);
  --ink3:rgba(255,255,255,0.22);
}
html,body{height:100%;overflow:hidden;background:var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif}

.deck{width:100vw;height:100vh;position:relative}
.slide{
  position:absolute;inset:0;
  display:flex;flex-direction:column;justify-content:center;
  padding:72px 100px;
  opacity:0;pointer-events:none;
  transition:opacity .55s ease,transform .55s ease;
  transform:translateX(50px);
}
.slide.active{opacity:1;pointer-events:all;transform:translateX(0)}
.slide.exit{opacity:0;transform:translateX(-50px)}

/* BG */
.bg-grid{
  position:absolute;inset:0;pointer-events:none;
  background-image:linear-gradient(rgba(201,168,76,0.03) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(201,168,76,0.03) 1px,transparent 1px);
  background-size:64px 64px;
}
.glow{position:absolute;border-radius:50%;filter:blur(130px);pointer-events:none}

/* NAV */

.arrow{
  position:fixed;top:50%;transform:translateY(-50%);
  width:44px;height:44px;border-radius:50%;
  background:rgba(10,15,13,0.8);border:1px solid var(--border);
  color:var(--gold);display:flex;align-items:center;justify-content:center;
  cursor:pointer;z-index:100;font-size:20px;line-height:1;
  backdrop-filter:blur(12px);transition:all .25s;user-select:none;
}
.arrow:hover{background:rgba(201,168,76,0.12);border-color:rgba(201,168,76,0.4)}
.arrow-left{left:24px}
.arrow-right{right:24px}

/* HINT */
.hint{position:fixed;top:28px;right:36px;font-family:'JetBrains Mono',monospace;font-size:10px;color:var(--ink3);letter-spacing:1px}

/* BRAND */
.brand{position:fixed;top:28px;left:36px;display:flex;align-items:center;gap:10px;z-index:100}
.brand-dot{width:8px;height:8px;border-radius:50%;background:var(--green);animation:pulse 2s infinite}
.brand-name{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:2px;color:var(--ink3);text-transform:uppercase}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

/* TYPOGRAPHY */
.eyebrow{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;margin-bottom:20px;display:flex;align-items:center;gap:12px}
.eyebrow::before{content:'';width:28px;height:1px;background:var(--gold)}

.display{font-family:'Syne',sans-serif;font-weight:800;line-height:1;letter-spacing:-2px;margin-bottom:24px}
.display .w1{display:block;color:var(--ink)}
.display .w2{display:block;background:linear-gradient(90deg,var(--gold),var(--green));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.display .w3{display:block;color:var(--ink2);font-weight:700}

.lead{font-size:18px;color:var(--ink2);line-height:1.8;max-width:640px;font-weight:300;margin-bottom:36px}
.lead strong{color:var(--ink);font-weight:500}

/* SECTION */
.sec-head{margin-bottom:36px}
.sec-label{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;margin-bottom:16px}
.sec-title{font-family:'Syne',sans-serif;font-size:clamp(28px,3.5vw,46px);font-weight:800;line-height:1.1;margin-bottom:16px}
.sec-title em{color:var(--green);font-style:normal}
.sec-title .gold{color:var(--gold)}
.sec-body{font-size:16px;color:var(--ink2);line-height:1.8;max-width:700px;font-weight:300}
.sec-body strong{color:var(--ink);font-weight:500}

/* GRID LAYOUTS */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.three-col{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}

/* CARD */
.card{
  background:rgba(255,255,255,0.025);
  border:1px solid var(--border);border-radius:16px;padding:28px;
  position:relative;overflow:hidden;
}
.card::after{content:'';position:absolute;top:0;left:0;right:0;height:1.5px;background:linear-gradient(90deg,var(--gold),transparent)}
.card-icon{font-size:28px;margin-bottom:14px}
.card-title{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;margin-bottom:8px}
.card-body{font-size:13px;color:var(--ink2);line-height:1.6}

/* LIST ITEMS */
.item-list{display:flex;flex-direction:column;gap:14px}
.item{display:flex;gap:16px;align-items:flex-start;padding:16px 20px;background:rgba(255,255,255,0.02);border:1px solid var(--border);border-radius:12px}
.item-icon{font-size:20px;flex-shrink:0;margin-top:1px}
.item-title{font-size:14px;font-weight:600;margin-bottom:3px}
.item-desc{font-size:13px;color:var(--ink2);line-height:1.5}

/* HIGHLIGHT */
.hl{
  background:linear-gradient(135deg,rgba(201,168,76,0.08),rgba(106,191,30,0.06));
  border:1px solid rgba(201,168,76,0.2);border-radius:16px;padding:28px 32px;
}
.hl p{font-size:15px;color:var(--ink2);line-height:1.8;font-weight:300}
.hl strong{color:var(--gold);font-weight:500}
.hl em{color:var(--green);font-style:normal}

/* QUOTE */
.big-q{
  font-family:'Syne',sans-serif;font-size:clamp(24px,3.2vw,40px);font-weight:700;
  line-height:1.3;max-width:820px;margin:0 auto;text-align:center;
}
.big-q em{background:linear-gradient(90deg,var(--gold),var(--green));-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-style:normal}

/* STAT ROW */
.stat-row{display:flex;gap:48px;margin-top:8px;flex-wrap:wrap}
.sv{font-family:'Syne',sans-serif;font-size:clamp(36px,4vw,54px);font-weight:800;color:var(--gold);line-height:1}
.sl{font-size:12px;color:var(--ink2);text-transform:uppercase;letter-spacing:2px;margin-top:4px}

/* TIMELINE */
.tline{position:relative;display:flex;flex-direction:column;gap:0;padding-left:48px}
.tline::before{content:'';position:absolute;left:16px;top:20px;bottom:20px;width:1px;background:linear-gradient(to bottom,var(--gold),rgba(106,191,30,0.3))}
.titem{padding:14px 0;position:relative}
.titem::before{content:'';position:absolute;left:-36px;top:22px;width:10px;height:10px;border-radius:50%;background:var(--bg);border:2px solid var(--gold)}
.tphase{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:2px;color:var(--gold);margin-bottom:4px}
.ttitle{font-family:'Syne',sans-serif;font-weight:700;font-size:15px;margin-bottom:4px}
.tdesc{font-size:13px;color:var(--ink2);line-height:1.5}

/* TAGS */
.tags{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.tag{padding:7px 16px;border:1px solid var(--border);border-radius:20px;font-size:12px;color:var(--ink2);font-family:'JetBrains Mono',monospace}
.tag.gold{border-color:rgba(201,168,76,0.4);color:var(--gold)}
.tag.green{border-color:rgba(106,191,30,0.4);color:var(--green)}
</style>
</head>
